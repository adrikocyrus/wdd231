# Copy this file to .env and replace every placeholder before starting Compose.
# Production requires an HTTPS origin, COOKIE_SECURE=true, and a production
# frontend URL. Use URL-safe hexadecimal values for database and Redis passwords.
DB_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
DB_APP_PASSWORD=replace_with_a_long_random_app_password
REDIS_PASSWORD=replace_with_another_long_random_password
JWT_SECRET=replace_with_at_least_32_random_characters
CRMS_ENCRYPTION_KEY=replace_with_base64_for_exactly_32_random_bytes
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development
COOKIE_SECURE=false
